<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>cslite</AssemblyName>
    <RootNamespace>CsLite</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Targeting net8.0 keeps the server runnable on older machines, but by
         default a net8.0 app refuses to start unless the .NET 8 runtime itself
         is present. Rolling forward lets one published build run on whatever
         newer runtime a machine happens to have, which is the difference
         between "works here" and "works where you put it". -->
    <RollForward>LatestMajor</RollForward>
    <!-- We never want the server's own stdout polluted by build/runtime chatter. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Features" Version="4.14.0" />
  </ItemGroup>

  <!-- The test fixtures are whole C# projects of their own, and tests/README
       tells you to generate them here. The SDK globs **/*.cs, so without this
       they are compiled into the server and it fails to build: several of them
       have top-level statements, and one does not compile on purpose. -->
  <ItemGroup>
    <Compile Remove="fixtures/**" />
    <None Remove="fixtures/**" />
    <EmbeddedResource Remove="fixtures/**" />
  </ItemGroup>

</Project>
